{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "snapshot_id",
    "operation",
    "repository_scope",
    "relation_allowlist",
    "max_depth",
    "max_nodes",
    "max_edges",
    "max_paths",
    "max_result_bytes"
  ],
  "properties": {
    "query_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "ORIENT",
        "FIND",
        "EXPAND",
        "TRACE",
        "DIFF"
      ]
    },
    "repository_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "relation_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "max_edges": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_paths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "max_result_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10000000
    },
    "payload": {
      "type": "object"
    }
  }
}
