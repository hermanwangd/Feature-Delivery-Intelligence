{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SnapshotBindingAttestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_id",
    "snapshot_id",
    "provider_scope_id",
    "provider_ref",
    "repository_bindings",
    "queryable",
    "runtime_version",
    "wire_version",
    "adapter_version",
    "compatibility",
    "result",
    "captured_at"
  ],
  "properties": {
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_scope_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_ref": {
      "type": "string",
      "minLength": 1
    },
    "repository_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "canonical_revision",
          "indexed_revision",
          "indexed_ref"
        ],
        "properties": {
          "repository_id": {
            "type": "string"
          },
          "canonical_revision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "indexed_revision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "indexed_ref": {
            "type": "string"
          }
        }
      }
    },
    "queryable": {
      "const": true
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "wire_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "const": "VERIFIED"
    },
    "result": {
      "const": "EXACTLY_BOUND"
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
