{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GrafelBindingEvidenceRecord.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "snapshot",
    "attestation",
    "provider_route",
    "runtime_version",
    "wire_version",
    "adapter_version",
    "compatibility",
    "captured_at",
    "result"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "provider",
        "provider_scope_id",
        "provider_ref",
        "repositories"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "adapter_version"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "adapter_version": {
              "type": "string"
            }
          }
        },
        "provider_scope_id": {
          "type": "string"
        },
        "provider_ref": {
          "type": "string"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository_id",
              "local_path",
              "canonical_revision"
            ],
            "properties": {
              "repository_id": {
                "type": "string"
              },
              "local_path": {
                "type": "string"
              },
              "canonical_revision": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              }
            }
          }
        }
      }
    },
    "attestation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "SnapshotBindingAttestation.schema.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "snapshot_id",
        "provider_scope_id",
        "provider_ref",
        "repository_bindings",
        "queryable",
        "runtime_version",
        "wire_version",
        "adapter_version",
        "compatibility",
        "result",
        "captured_at"
      ],
      "properties": {
        "attestation_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1
        },
        "repository_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository_id",
              "canonical_revision",
              "indexed_revision",
              "indexed_ref"
            ],
            "properties": {
              "repository_id": {
                "type": "string"
              },
              "canonical_revision": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "indexed_revision": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "indexed_ref": {
                "type": "string"
              }
            }
          }
        },
        "queryable": {
          "const": true
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "wire_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "compatibility": {
          "const": "VERIFIED"
        },
        "result": {
          "const": "EXACTLY_BOUND"
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "ref"
      ],
      "properties": {
        "group": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "wire_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "const": "VERIFIED"
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "const": "EXACTLY_BOUND"
    }
  }
}
