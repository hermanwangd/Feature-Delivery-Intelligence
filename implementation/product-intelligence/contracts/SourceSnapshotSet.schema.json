{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_set_id",
    "captured_at",
    "repositories"
  ],
  "properties": {
    "snapshot_set_id": {
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "remote",
          "local_path",
          "revision"
        ],
        "properties": {
          "repository_id": {
            "type": "string"
          },
          "remote": {
            "type": "string"
          },
          "local_path": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "branch_or_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
