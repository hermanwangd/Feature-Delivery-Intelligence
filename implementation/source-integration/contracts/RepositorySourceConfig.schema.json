{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "provider",
    "repositories"
  ],
  "properties": {
    "product": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "AZURE_REPOS",
            "LOCAL_GIT"
          ]
        },
        "organization": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "remote"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "remote": {
            "type": "string"
          },
          "branch_or_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
