{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdi.local/validation/ground-truth-change-set.schema.json",
  "title": "GroundTruthChangeSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_name", "format_version", "feature_id", "required_repositories", "surfaces", "required_interface_ids", "required_validation_ids", "owner_id", "reviewer_id", "approval_state"],
  "properties": {
    "format_name": {"const": "GroundTruthChangeSet"}, "format_version": {"const": "1.0.0"}, "feature_id": {"type": "string", "pattern": "^(calibration|holdout)-0[1-4]$"},
    "required_repositories": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repository_id", "revision"], "properties": {"repository_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}}}},
    "surfaces": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["surface_id", "repository_id", "path", "symbol_or_anchor", "critical"], "properties": {"surface_id": {"type": "string", "minLength": 1}, "repository_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "symbol_or_anchor": {"type": ["string", "null"]}, "critical": {"type": "boolean"}}}},
    "required_interface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "required_validation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "owner_id": {"type": "string", "minLength": 1}, "reviewer_id": {"type": "string", "minLength": 1}, "approval_state": {"const": "FROZEN_APPROVED"}
  }
}
