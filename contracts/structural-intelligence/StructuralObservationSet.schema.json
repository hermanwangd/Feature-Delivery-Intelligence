{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_set_id",
    "snapshot_id",
    "provider",
    "observations"
  ],
  "properties": {
    "observation_set_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "provider": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "observation_type",
          "evidence_refs"
        ],
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "observation_type": {
            "enum": [
              "REPOSITORY",
              "COMPONENT",
              "INTERFACE",
              "API_RELATION",
              "EVENT_RELATION",
              "SCHEMA_RELATION",
              "PACKAGE_RELATION",
              "DATA_RELATION",
              "CONFIG_RELATION",
              "DEPLOYMENT_RELATION"
            ]
          },
          "from": {
            "type": "object"
          },
          "to": {
            "type": "object"
          },
          "relation": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
