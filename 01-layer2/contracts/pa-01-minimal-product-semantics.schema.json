{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fdi://layer2/pa-01-minimal-product-semantics/v0.1",
  "title": "PA-01 Minimal Product Semantics",
  "type": "object",
  "required": [
    "fdi_asset_version",
    "asset_id",
    "asset_family",
    "asset_type",
    "asset_revision",
    "descriptor_ref",
    "content_ref",
    "publication_state",
    "validity_state",
    "owner",
    "maintenance_mode",
    "publication_policy",
    "scope",
    "authority_dimensions",
    "trust_profile",
    "as_of",
    "source_refs",
    "dependency_refs",
    "freshness_policy",
    "supersedes",
    "invalidation_triggers",
    "selection_metadata",
    "product",
    "sub_products",
    "capabilities"
  ],
  "properties": {
    "fdi_asset_version": {"const": "0.1"},
    "asset_id": {"type": "string", "minLength": 1},
    "asset_family": {"const": "PRODUCT"},
    "asset_type": {"const": "PA-01_MINIMAL_PRODUCT_SEMANTICS"},
    "asset_revision": {"type": "integer", "minimum": 1},
    "descriptor_ref": {"type": "string", "minLength": 1},
    "content_ref": {"type": "string", "minLength": 1},
    "publication_state": {"enum": ["DRAFT", "PUBLISHED", "RETIRED"]},
    "validity_state": {"enum": ["NOT_APPLICABLE", "ACTIVE", "STALE", "SUPERSEDED"]},
    "owner": {"type": "string", "minLength": 1},
    "maintenance_mode": {"enum": ["CURATED", "DERIVED", "REFERENCED"]},
    "publication_policy": {"enum": ["HUMAN_APPROVAL", "RULE_BASED_AUTO", "SOURCE_REFERENCE"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["products", "systems", "repositories", "environments"],
      "properties": {
        "products": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "systems": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "repositories": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "environments": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "authority_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["DURABLE_CONSTRAINT", "CURRENT_BEHAVIOR_SUPPORT", "RATIONALE_SUPPORT"]}
    },
    "trust_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "review", "verification", "authorization"],
      "properties": {
        "provenance": {"enum": ["DIRECT", "DERIVED", "ASSERTED"]},
        "review": {"enum": ["UNREVIEWED", "REVIEWED"]},
        "verification": {"enum": ["NOT_VERIFIED", "VERIFIED"]},
        "authorization": {"enum": ["NONE", "SOURCE_INHERITED", "EXPLICIT"]}
      }
    },
    "as_of": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependency_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ttl"],
      "properties": {
        "mode": {"enum": ["UNTIL_SUPERSEDED", "SOURCE_CHANGE", "TTL", "EVENT_DRIVEN", "MANUAL"]},
        "ttl": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "TTL"}}, "required": ["mode"]},
          "then": {"properties": {"ttl": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "asset_revision"],
          "properties": {
            "asset_id": {"type": "string", "minLength": 1},
            "asset_revision": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "invalidation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trigger_type", "source_scope", "effect"],
        "properties": {
          "trigger_type": {"enum": ["SOURCE_CHANGED", "DEPENDENCY_CHANGED", "POLICY_SUPERSEDED", "SCOPE_CHANGED", "EXPIRY", "MANUAL_REVIEW"]},
          "source_scope": {"type": "string", "minLength": 1},
          "effect": {"enum": ["WHOLE_ASSET", "SCOPED_RECORD", "RECHECK_REQUIRED"]}
        },
        "additionalProperties": false
      }
    },
    "selection_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "applicability"],
      "properties": {
        "terms": {"type": "array", "items": {"type": "string"}},
        "applicability": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reviewed_by": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "published_by": {"type": "string", "minLength": 1},
    "proposed_by": {"type": "string", "minLength": 1},
    "lifecycle_events": {"type": "array", "items": {"type": "object"}},
    "product": {
      "type": "object",
      "required": ["product_id", "name"],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sub_products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sub_product_id", "parent_id", "name"],
        "properties": {
          "sub_product_id": {"type": "string", "minLength": 1},
          "parent_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "parent_id", "name", "scope_statement", "semantic_refs"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "parent_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "scope_statement": {"type": "string", "minLength": 1},
          "semantic_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {"properties": {"publication_state": {"const": "DRAFT"}, "validity_state": {"const": "NOT_APPLICABLE"}}},
        {"properties": {"publication_state": {"const": "PUBLISHED"}, "validity_state": {"const": "ACTIVE"}}},
        {"properties": {"publication_state": {"const": "PUBLISHED"}, "validity_state": {"const": "STALE"}}},
        {"properties": {"publication_state": {"const": "PUBLISHED"}, "validity_state": {"const": "SUPERSEDED"}}},
        {"properties": {"publication_state": {"const": "RETIRED"}, "validity_state": {"const": "NOT_APPLICABLE"}}}
      ]
    }
  ],
  "additionalProperties": true
}
